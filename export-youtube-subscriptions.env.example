# export-youtube-subscriptions.env: settings for export-youtube-subscriptions.
#
# Copy to export-youtube-subscriptions.env (gitignored) next to the
# executable, or to ~/.config/export-youtube-subscriptions/
# ($XDG_CONFIG_HOME is honoured), or point --env-file / $EYS_ENV_FILE at it.
#
# Lookup order (first match wins, only one file is read):
#   1. --env-file PATH        must exist
#   2. $EYS_ENV_FILE          must exist
#   3. <dir of the executable, symlinks resolved>/export-youtube-subscriptions.env
#   4. ~/.config/export-youtube-subscriptions/export-youtube-subscriptions.env
#
# Precedence per setting: CLI flag > real environment variable > this file > built-in default.
#
# Syntax: KEY=VALUE, one per line. '#' starts a comment (at line start, or
# after whitespace). Optional "double" (expands ~ and $HOME) or 'single'
# (literal) quotes. A leading `export ` is allowed. Only ~ and $HOME/${HOME}
# are expanded; no other $VARS. Relative paths are resolved against the
# directory this file is in, not the current directory. Empty value = unset.

# Where musicians.md, youtubers.md and overrides.txt live. Created (mkdir -p)
# if missing. Default if unset everywhere: the current directory.
EYS_OUTPUT_DIR=~/notes/pages

# OAuth Desktop client JSON. Default: client_secret.json in the current directory.
#EYS_CLIENT_SECRETS=~/.config/export-youtube-subscriptions/client_secret.json

# Cached OAuth token. Default: ~/.config/export-youtube-subscriptions/token.json
#EYS_TOKEN_PATH=~/.config/export-youtube-subscriptions/token.json
